{
  "name": "mackenzie",
  "version": "0.1.0",
  "private": true,
  "description": "One golfer profile: a longitudinal shot ledger and a mapped, sourced history of every course played.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx scripts/ingest.ts",
    "compare": "tsx scripts/compare.ts",
    "profile": "tsx scripts/profile.ts",
    "flight": "tsx scripts/ball-flight.ts",
    "data:parse": "node scripts/parse-grint.mjs",
    "data:spine": "node scripts/rounds-to-spine.mjs",
    "data:geocode": "node scripts/geocode.mjs",
    "data:osm": "node scripts/fetch-osm.mjs",
    "data:holes": "node scripts/fetch-holes.mjs",
    "data:build": "node scripts/build.mjs",
    "data:validate": "node scripts/validate.mjs",
    "data:inventory": "node scripts/inventory-grint-export.mjs",
    "data:rounds": "node scripts/parse-grint-export.mjs",
    "data:garmin:inventory": "node scripts/inventory-garmin-export.mjs",
    "data:all": "pnpm data:parse && pnpm data:spine && pnpm data:geocode && pnpm data:osm && pnpm data:holes && pnpm data:build && pnpm data:validate"
  },
  "dependencies": {
    "next": "^15.5.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.4",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
